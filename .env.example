# ─── Base de données (Neon / Vercel Postgres) ───
# Utilisez l'URL "pooled" Neon pour Vercel serverless
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# URL directe (sans pooler) — requise pour prisma db push / migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# ─── Auth (NextAuth) ───
# Doit correspondre au port du serveur dev (npm run dev → port 3001)
# Production : https://votre-projet.vercel.app (sans slash final)
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── URL publique (identique à NEXTAUTH_URL, même port en local) ───
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_WHATSAPP_NUMBER="+2250749526194"

# ─── Paiement CinetPay (Côte d'Ivoire) ───
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_NOTIFY_URL="https://votre-domaine.vercel.app/api/payments/webhook"
CINETPAY_RETURN_URL="https://votre-domaine.vercel.app/reservation/confirmation"

# ─── Email (optionnel) ───
RESEND_API_KEY=""
EMAIL_FROM="contact@conseil-image-ariane.com"

# ─── SMS / WhatsApp (optionnel) ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# ─── Analytics (optionnel) ───
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ─── Upload images (Vercel Blob — production) ───
# Créé automatiquement quand vous connectez un store Blob au projet Vercel
BLOB_READ_WRITE_TOKEN=""

# ─── Vercel (automatique, ne pas définir manuellement) ───
# VERCEL_URL est injecté par Vercel à chaque déploiement
